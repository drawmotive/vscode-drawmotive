{
  "name": "vscode-drawmotive",
  "displayName": "DrawMotive - Diagram & Flowchart Editor",
  "description": "Make your ideas easy to understand. Edit diagrams in VS Code and share them as PNGs you can open and edit again.",
  "version": "0.2.9",
  "publisher": "drawmotive",
  "repository": {
    "type": "git",
    "url": "https://github.com/drawmotive/vscode-drawmotive.git"
  },
  "bugs": {
    "url": "https://github.com/drawmotive/vscode-drawmotive/issues"
  },
  "homepage": "https://docs.drawmotive.com",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "diagram",
    "flowchart",
    "drawing",
    "uml",
    "technical diagram",
    "architecture diagram",
    "png",
    "visual",
    "documentation",
    "offline",
    "whiteboard",
    "sketch"
  ],
  "activationEvents": [
    "onCustomEditor:drawmotive.editor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "drawmotive.editor",
        "displayName": "DrawMotive Editor",
        "selector": [
          {
            "filenamePattern": "*.draw.png"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "drawmotive.newDrawing",
        "title": "New Diagram",
        "category": "DrawMotive"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run assets:prepare && webpack",
    "watch": "npm run assets:prepare && webpack --watch",
    "package": "npm run build",
    "lint": "eslint src",
    "vsce:package": "node .release/check.cjs --build && vsce package --no-dependencies",
    "vsce:publish": "node scripts/publish-stable.cjs",
    "release:check": "node .release/check.cjs --ready",
    "assets:prepare": "node scripts/prepare-editor.cjs",
    "examples:render": "tsc && node scripts/render-example.mjs",
    "test": "tsc && node --test --test-concurrency=1 test/*.test.cjs",
    "test:browser": "npm run compile && tsc && node --test --test-concurrency=1 test/*.browser.cjs",
    "test:browser:candidate": "node scripts/test-browser-candidate.cjs",
    "build": "node .release/check.cjs --build && npm run compile -- --mode production",
    "test:host:candidate": "node scripts/test-host-candidate.mjs",
    "test:host:vsix": "node scripts/test-host-candidate.mjs --vsix",
    "release:verify-retained": "node scripts/verify-retained.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright": "1.63.0",
    "ts-loader": "^9.6.2",
    "typescript": "~6.0.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "@drawmotive/editor": "0.2.2-alpha.9"
  }
}
